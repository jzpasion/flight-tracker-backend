# Copy this file to `.env` and adjust as needed.
# Loaded automatically by `npm start` / `npm run dev` (Node --env-file-if-exists).
# All values are optional; the defaults below are used when unset.

# HTTP / Socket.IO server port
PORT=8000

# Allowed CORS origin for Socket.IO (use a specific URL in production, e.g. https://your-frontend.app)
CORS_ORIGIN=*

# How often (ms) to refresh the flight list for each connected client
POLL_INTERVAL_MS=7000

# Per-request timeout (ms) for outbound ADS-B API calls
REQUEST_TIMEOUT_MS=5000

# Flight-list providers, tried in order (comma-separated). Both must speak the readsb
# /v2/point/{lat}/{lon}/{radius} schema. Leave unset to use the built-in defaults.
# FLIGHT_LIST_PROVIDERS=https://api.airplanes.live/v2/point,https://api.adsb.lol/v2/point
